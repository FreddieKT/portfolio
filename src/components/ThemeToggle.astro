<button
  id="theme-toggle"
  class="theme-toggle is-dark"
  type="button"
  aria-label="Toggle color theme"
  aria-pressed="false"
  title="Switch to light theme"
>
  <svg class="theme-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <g class="sun-icon">
      <g class="sun-rays">
        <path d="M12 2.75V5" vector-effect="non-scaling-stroke" />
        <path d="M12 19v2.25" vector-effect="non-scaling-stroke" />
        <path d="M4.22 4.22l1.6 1.6" vector-effect="non-scaling-stroke" />
        <path d="M18.18 18.18l1.6 1.6" vector-effect="non-scaling-stroke" />
        <path d="M2.75 12H5" vector-effect="non-scaling-stroke" />
        <path d="M19 12h2.25" vector-effect="non-scaling-stroke" />
        <path d="M4.22 19.78l1.6-1.6" vector-effect="non-scaling-stroke" />
        <path d="M18.18 5.82l1.6-1.6" vector-effect="non-scaling-stroke" />
      </g>
      <circle cx="12" cy="12" r="3.8" vector-effect="non-scaling-stroke" />
    </g>
    <g class="moon-icon">
      <path d="M20 14.6A7.2 7.2 0 0 1 9.4 4 8.2 8.2 0 1 0 20 14.6Z" vector-effect="non-scaling-stroke" />
      <path class="moon-spark" d="M15.2 3.8h2.1M16.25 2.75v2.1" vector-effect="non-scaling-stroke" />
    </g>
  </svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    if (!button) return;

    const storageKey = 'freddie-portfolio-theme';
    const preferredTheme = () => {
      const stored = window.localStorage.getItem(storageKey);
      if (stored === 'light' || stored === 'dark') return stored;
      return root.dataset.theme || 'dark';
    };

    const applyTheme = (theme) => {
      const isLight = theme === 'light';
      root.dataset.theme = theme;
      button.setAttribute('aria-pressed', String(isLight));
      button.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
      button.title = isLight ? 'Switch to dark theme' : 'Switch to light theme';
      button.classList.toggle('is-light', isLight);
      button.classList.toggle('is-dark', !isLight);
    };

    applyTheme(preferredTheme());

    button.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
      window.localStorage.setItem(storageKey, nextTheme);
      applyTheme(nextTheme);
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: var(--border-solid);
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: var(--interactive-overlay);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .theme-icon-svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    color: currentColor;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .sun-icon,
  .moon-icon,
  .sun-rays {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 220ms ease,
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sun-icon {
    opacity: 0;
    transform: rotate(-35deg) scale(0.45);
  }

  .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle.is-light .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle.is-light .sun-rays {
    animation: light-rays 650ms ease-out;
  }

  .theme-toggle.is-light .moon-icon {
    opacity: 0;
    transform: rotate(35deg) scale(0.45);
  }

  .theme-toggle.is-dark .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle.is-dark .sun-icon {
    opacity: 0;
    transform: rotate(-35deg) scale(0.45);
  }

  @keyframes light-rays {
    0% {
      opacity: 0;
      transform: rotate(-45deg) scale(0.35);
    }
    65% {
      opacity: 1;
      transform: rotate(10deg) scale(1.12);
    }
    100% {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sun-icon,
    .moon-icon,
    .sun-rays {
      animation: none !important;
      transition: none;
    }
  }
</style>
