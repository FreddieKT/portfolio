---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<li class="project-row" data-animate="project-card">
  <a href={`/labs/${project.slug}`} class="row-link" aria-label={`View ${project.title}`}>
    <span class="row-num">{project.index}</span>
    <span class="row-dot" aria-hidden="true"></span>
    <span class="row-body">
      <span class="row-title">{project.title}</span>
      <span class="row-label">{project.label} · {project.category}</span>
    </span>
    <span class="row-tags" aria-label="Stack">
      {project.stack.slice(0, 2).map((s) => <span class="row-tag">{s}</span>)}
    </span>
    <span class="row-arrow" aria-hidden="true">↗</span>
    {project.image && (
      <Image class="row-thumb" src={project.image} alt="" widths={[320, 640]} sizes="(max-width: 600px) 90vw, 320px" loading="lazy" />
    )}
  </a>

</li>

<style>
  .project-row {
    list-style: none;
    border-bottom: none;
  }

  .project-row:last-child {
    border-bottom: none;
  }

  .row-link {
    display: grid;
    grid-template-columns: 2rem 1.25rem 1fr auto 1.5rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    color: inherit;
    text-decoration: none;
    transition: background 140ms ease;
  }

  .row-link:hover {
    background: var(--accent-soft);
  }

  .row-link:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: -2px;
  }

  .row-num {
    font-size: var(--text-xs);
    color: var(--muted-faint);
    letter-spacing: 0.1em;
  }

  .row-dot {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    opacity: 0.65;
    flex-shrink: 0;
  }

  .row-body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--foreground);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .row-label {
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-tags {
    display: flex;
    gap: 0.35rem;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .row-tag {
    font-size: 0.6rem;
    color: var(--muted);
    border: none;
    padding: 0.15rem 0.45rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .row-thumb {
    grid-column: 3 / -1;
    display: block;
    width: min(100%, 20rem);
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-sm);
    opacity: 0.9;
    transition: opacity 140ms ease;
  }

  .row-link:hover .row-thumb {
    opacity: 1;
  }

  .row-arrow {
    font-size: var(--text-sm);
    color: var(--accent);
    text-align: right;
  }

  @media (max-width: 600px) {
    .row-tags { display: none; }
    .row-link {
      grid-template-columns: 2rem 1.25rem 1fr 1.5rem;
    }
  }
</style>
