---
import ThemeToggle from './ThemeToggle.astro';

interface NavItem { label: string; href: string; }
interface Props { navItems?: NavItem[]; }

const { navItems = [
  { label: 'ABOUT', href: '/about' },
  { label: 'LABS', href: '/labs' },
] } = Astro.props;
const links = [...navItems.filter((item) => item.href !== '/contact'), { label: 'CONTACT', href: '/contact' }];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => pathname === href ? 'page' : pathname.startsWith(`${href}/`) ? 'location' : undefined;
---

<header class="site-header" aria-label="Primary">
  <a class="brand-mark" href="/" aria-label="FREDDIE K. home" aria-current={pathname === '/' ? 'page' : undefined}>Freddie K.</a>
  <nav class="main-nav" aria-label="Main navigation">
    {links.map((item) => (
      <a class="nav-link" href={item.href} aria-current={current(item.href)}>
        {item.label.charAt(0) + item.label.slice(1).toLowerCase()}
      </a>
    ))}
  </nav>
  <div class="theme-control"><ThemeToggle /></div>
</header>

<style>
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 */
  /* Hallmark · component: navigation · genre: terminal · theme: existing tokens
   * Centered text navigation; no group container, with an underline for the current page. */
  .site-header {
    display: grid;
    --nav-radius: 999px;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-5);
    /* Sticks for the whole scroll. The extra 1rem on top scrolls away (top: -1rem), so the stuck
       bar stays compact. The opaque band reaches both screen edges and covers content and grid. */
    position: sticky;
    top: -1rem;
    z-index: 10;
    padding: calc(1rem + var(--space-2)) 1rem var(--space-4);
    background: var(--background);
    box-shadow: 0 0 0 100vmax var(--background);
    clip-path: inset(0 -100vmax);
  }
  /* Full-width hairline under the bar; motion.css fades it in once the page scrolls. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto -100vmax 0;
    height: 1px;
    background: var(--border);
    opacity: 0;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1;
    color: var(--foreground);
    white-space: nowrap;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: center;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding-inline: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--muted);
    white-space: nowrap;
    text-decoration: none;
  }
  .nav-link[aria-current] {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  @media (hover: hover) {
    .nav-link:hover, .brand-mark:hover { color: var(--accent); }
    .theme-control :global(.theme-toggle:hover) { color: var(--accent); background: var(--interactive-overlay); }
  }
  .nav-link:focus-visible, .brand-mark:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .nav-link:active, .brand-mark:active { color: var(--accent-strong); }
  .theme-control { display: flex; align-items: center; justify-self: end; }
  .theme-control :global(.theme-toggle) {
    border-color: transparent;
    border-radius: var(--nav-radius);
    background: var(--interactive-overlay);
    color: var(--muted);
    box-shadow: none;
  }
  .theme-control :global(.theme-toggle:focus-visible) {
    color: var(--accent);
    background: var(--interactive-overlay);
    box-shadow: none;
  }
  .theme-control :global(.theme-toggle:active) { background: var(--accent-soft); }
  @media (max-width: 768px) {
    .site-header { padding-inline: 0.75rem; }
  }
  @media (max-width: 600px) {
    .site-header { grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-2); row-gap: var(--space-3); }
    .theme-control { grid-column: 2; grid-row: 1; }
    .main-nav { grid-column: 1 / -1; grid-row: 2; gap: var(--space-1); width: 100%; }
    .nav-link { flex: 1; }
  }
</style>
