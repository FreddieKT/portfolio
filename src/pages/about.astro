---
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile-about.jpg';
import sunderlandLogo from '../assets/logos/sunderland.svg';
import tmcLogo from '../assets/logos/tmc.png';
import kmdLogo from '../assets/logos/kmd.png';
import PageLayout from '../layouts/PageLayout.astro';
import PageSidebar from '../components/PageSidebar.astro';
import SectionLabel from '../components/SectionLabel.astro';

const sidebarItems = [
  { label: 'IDENTITY', href: '#identity' },
  { label: 'EDUCATION', href: '#timeline' },
  { label: 'TOOLS',    href: '#stack' },
  { label: 'APPROACH', href: '#approach' },
  { label: 'LINKS',    href: '#links' },
];

const timeline = [
  {
    year: '2019–22',
    text: 'Studied for a Higher National Diploma, Computing',
    where: 'KMD Computer Centre',
    subjects: 'programming, databases, SQL',
    logo: kmdLogo, tint: true,
    label: 'Units',
    units: [
      'Computer Systems Fundamentals',
      'Developing Software: Introduction',
      'Software Development: Programming Foundations',
      'Database Design Fundamentals',
      'SQL Introduction',
      'Professionalism and Ethics in Computing',
      'Small-scale Standalone Application (VB.Net)',
      'Troubleshooting Computing Problems',
      'Introduction to Project Management',
      'HND Computing: Graded Unit 1',
      'Scripting for Interactivity',
      'Mathematics for Computing 1',
    ],
  },
  {
    year: '2022–24',
    text: 'Higher Diploma, Infocomm Technology',
    where: 'TMC Academy',
    subjects: 'databases, web, mobile',
    logo: tmcLogo, tint: true,
    label: 'Modules',
    units: [
      'Project Management',
      'Database Systems and Applications',
      'Application Programming with Java',
      'Information Systems Analysis and Design',
      'Web Programming and Applications',
      'Network Operating Systems',
      '.Net Programming with C#',
      'Development of Mobile Applications',
      'Object Oriented Programming with C++',
      'Cloud Computing Concepts',
      'Project',
    ],
  },
  {
    year: '2024–25',
    text: 'BSc (Hons) Computer Systems Engineering',
    where: 'University of Sunderland',
    subjects: 'AI, cyber security, data',
    logo: sunderlandLogo, mono: true,
    label: 'Modules',
    units: [
      'Artificial Intelligence',
      'Advanced Cyber Security',
      'Advanced Data Technologies',
      'Product Development',
      'Android Mobile Development',
      'Research',
    ],
  },
];

const stack = [
  'Python', 'TypeScript', 'React', 'Astro', 'FastAPI', 'Hermes Runtime',
];
---

<PageLayout
  title="About"
  description="I’m Freddie. I’m exploring AI tools through projects and sharing what worked and what I’m still working out."
>
  <PageSidebar slot="sidebar" heading="ABOUT" items={sidebarItems} activeHref="#identity" />

  <div class="about-content">

    <section id="identity" class="page-section frame" aria-labelledby="identity-heading">
      <SectionLabel id="identity-heading">Identity</SectionLabel>
      <div class="identity-layout">
        <figure class="identity-photo-frame">
          <Image
            src={profileImage}
            alt="Khant Thura Thaung"
            width={352}
            height={470}
            loading="eager"
            decoding="async"
            class="identity-photo"
          />
        </figure>
        <div class="identity-text">
          <h1 class="identity-name">FREDDIE K.</h1>
          <p class="mini-kicker">CURIOUS BUILDER</p>
          <p class="mono-copy identity-bio">
            I’m Khant Thura Thaung, though I usually go by Freddie online.
            Lately, I’ve been exploring AI tools and how they fit into my day-to-day life.
          </p>
          <p class="mono-copy identity-bio">
            I’m figuring out where these tools are useful to me by trying them on projects.
            This site is where I share those experiments, what worked, and what I’m still working out.
          </p>
        </div>
      </div>
    </section>

    <section id="timeline" class="page-section frame" aria-labelledby="timeline-heading">
      <SectionLabel id="timeline-heading">Education</SectionLabel>
      <ol class="timeline">
        {timeline.map((item, i) => (
          <li class="timeline-row">
            <span class="timeline-year">{item.year}</span>
            <span class="timeline-logo" aria-hidden="true">
              {item.logo && <img src={item.logo.src} alt="" height="28" loading="lazy" decoding="async" class:list={[{ mono: item.mono, tint: item.tint }]} />}
            </span>
            <div class="timeline-main">
              <button class="timeline-head" type="button" aria-expanded="false" aria-controls={`tl-panel-${i}`}>
                <span class="timeline-text">
                  {item.text}
                  <span class="timeline-where">{item.where}</span>
                  <span class="timeline-subjects">{item.subjects}</span>
                </span>
                <span class="timeline-toggle" aria-hidden="true"></span>
              </button>
              <div class="timeline-panel" id={`tl-panel-${i}`}>
                <div class="timeline-inner">
                  <p class="timeline-label">{item.label}</p>
                  <ul class="timeline-units">
                    {item.units.map((u) => <li>{u}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="stack" class="page-section frame" aria-labelledby="stack-heading">
      <SectionLabel id="stack-heading">Tools I’m using</SectionLabel>
      <p class="mono-copy">Tools behind this site and the projects shown here.</p>
      <div class="stack-tags">
        {stack.map((tool) => <span class="stack-tag">{tool}</span>)}
      </div>
    </section>

    <section id="approach" class="page-section frame" aria-labelledby="approach-heading">
      <SectionLabel id="approach-heading">Approach</SectionLabel>
      <div class="approach-text">
        <p class="mono-copy">Most of my projects start with something I want to understand or a task I am tired of repeating.</p>
        <p class="mono-copy">I usually build the smallest version I can use, then keep working on it only if it proves useful.</p>
        <p class="mono-copy">I care more about what a tool does in practice than how impressive it sounds in a description.</p>
      </div>
    </section>

    <section id="links" class="page-section frame" aria-labelledby="links-heading">
      <SectionLabel id="links-heading">Links</SectionLabel>
      <ul class="links-list">
        <li>
          <a class="link-row" href="https://github.com/FreddieKT" target="_blank" rel="noreferrer">
            <span class="link-dot" aria-hidden="true"></span>
            <span class="link-label">GITHUB</span>
            <span class="link-value">FreddieKT</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="link-row" href="https://x.com/ktythaung" target="_blank" rel="noreferrer">
            <span class="link-dot" aria-hidden="true"></span>
            <span class="link-label">X</span>
            <span class="link-value">@ktythaung</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="link-row" href="mailto:ktythaung@gmail.com">
            <span class="link-dot" aria-hidden="true"></span>
            <span class="link-label">EMAIL</span>
            <span class="link-value">ktythaung@gmail.com</span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </section>

  </div>

  <script>
    // Scroll-spy: the active item is the last section whose top has passed a line 35% down the
    // viewport, or the last section once the page bottoms out. Reading positions on scroll (not an
    // observer band) stays correct after jumps and never lands in the gap between sections.
    // A click marks its item at once and holds it while the smooth scroll settles.
    const sidebarLinks = [...document.querySelectorAll<HTMLAnchorElement>('.sidebar-item')];
    const sections = sidebarLinks.map((link) => document.querySelector<HTMLElement>(link.hash));
    const setActive = (hash: string) => sidebarLinks.forEach((link) => link.classList.toggle('is-active', link.hash === hash));
    let heldUntil = 0;
    let queued = false;

    const update = () => {
      queued = false;
      if (performance.now() < heldUntil) return;
      const line = innerHeight * 0.35;
      let current = sections[0];
      for (const section of sections) if (section && section.getBoundingClientRect().top <= line) current = section;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections.at(-1) ?? current;
      if (current) setActive(`#${current.id}`);
    };

    addEventListener('scroll', () => {
      if (!queued) requestAnimationFrame(update);
      queued = true;
    }, { passive: true });
    update();

    sidebarLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setActive(link.hash);
        heldUntil = performance.now() + 1000;
      });
    });

    const timeline = document.querySelector('.timeline');
    timeline?.classList.add('js');
    timeline?.querySelectorAll('.timeline-head').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.closest('.timeline-row')?.classList.toggle('is-open', !open);
      });
    });
  </script>
</PageLayout>

<style>
  .about-content {
    display: grid;
    gap: 1rem;
  }

  .page-section {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: grid;
    gap: 0.75rem;
  }

  .identity-layout {
    display: flex;
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: flex-start;
    min-width: 0;
  }

  .identity-photo-frame {
    flex: 0 0 auto;
    width: 7rem;
    aspect-ratio: 3 / 4;
    margin: 0;
    padding: 0.3rem;
    border: var(--border-solid-strong);
    border-radius: var(--radius-md);
    background: var(--surface-terminal);
    box-shadow: none;
  }

  .identity-photo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-md) - 0.2rem);
    object-fit: cover;
    object-position: 50% 0%;
    filter: saturate(0.95) contrast(1.02);
  }

  .identity-text {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .identity-name {
    margin: 0;
    font-weight: inherit;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
  }

  .identity-bio { max-width: 48ch; }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: none;
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stack-tag::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    opacity: 0.7;
    flex-shrink: 0;
  }

  .approach-text {
    display: grid;
    gap: 0.75rem;
  }

  .links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
  }

  .links-list li + li { border-top: none; }

  .link-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    min-width: 0;
    transition: background var(--motion-fast) var(--motion-ease), color var(--motion-fast) var(--motion-ease);
  }

  .link-row:is(:focus-visible, :active) {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .link-row:is(:focus-visible, :active) .link-dot { background: var(--accent); opacity: 1; }

  @media (hover: hover) {
    .link-row:hover {
      background: var(--accent-soft);
      color: var(--accent);
    }

    .link-row:hover .link-dot { background: var(--accent); opacity: 1; }
  }

  .link-dot {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    flex-shrink: 0;
    opacity: 0.75;
    transition: background var(--motion-fast) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease);
  }

  .link-label {
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    min-width: 5rem;
  }

  .link-value {
    font-size: var(--text-sm);
    color: var(--foreground-soft);
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .link-arrow {
    color: var(--accent);
    margin-left: auto;
  }

  @media (max-width: 600px) {
    .page-section {
      padding: 1rem;
    }

    .identity-layout {
      flex-direction: column;
    }
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 5.5rem 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.85rem 0;
    border-top: var(--border-dashed);
  }

  .timeline-logo {
    display: flex;
    align-items: center;
    width: 4.5rem;
    height: 2rem;
  }

  .timeline-logo img {
    height: 1.75rem;
    width: auto;
    max-width: 4.25rem;
    object-fit: contain;
  }

  :global(:root[data-theme="dark"]) .timeline-logo img.mono {
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* flips lightness but keeps hue, so coloured logos stay coloured on dark */
  :global(:root[data-theme="dark"]) .timeline-logo img.tint {
    filter: invert(1) hue-rotate(180deg);
  }

  .timeline-year {
    font-size: var(--text-sm);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .timeline-main {
    min-width: 0;
  }

  .timeline-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .timeline-head:focus-visible .timeline-text {
    color: var(--accent);
  }

  @media (hover: hover) {
    .timeline-head:hover .timeline-text {
      color: var(--accent);
    }
  }

  .timeline-head:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: 4px;
  }

  .timeline-text {
    font-size: var(--text-sm);
    color: var(--foreground-soft);
    min-width: 0;
    overflow-wrap: anywhere;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .timeline-toggle {
    position: relative;
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.2rem;
    color: var(--accent);
    transition: transform var(--motion-base) var(--motion-ease);
  }

  .timeline-toggle::before,
  .timeline-toggle::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
  }

  .timeline-toggle::after {
    transform: rotate(90deg);
  }

  .timeline-row.is-open .timeline-toggle {
    transform: rotate(45deg);
  }

  .timeline.js .timeline-panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
  }

  .timeline.js .is-open .timeline-panel {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  .timeline-inner {
    min-height: 0;
    overflow: hidden;
  }

  .timeline.js .timeline-inner {
    opacity: 0;
    transition: opacity var(--motion-base) var(--motion-ease);
  }

  .timeline.js .is-open .timeline-inner {
    opacity: 1;
  }

  .timeline-label {
    margin: 0.75rem 0 0.25rem;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .timeline-units {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.35rem 1.5rem;
  }

  .timeline-units li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--text-sm);
    color: var(--foreground-soft);
    overflow-wrap: anywhere;
  }

  .timeline-units li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
  }


  .timeline-subjects {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    color: var(--muted);
    font-style: italic;
  }

  .timeline-where {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
  }


  @media (max-width: 600px) {
    .timeline-row {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0.25rem 0.75rem;
    }

    .timeline-year {
      grid-column: 1 / -1;
    }

    .timeline-main {
      grid-column: 2;
    }
  }
</style>
