---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FooterStatus from '../components/FooterStatus.astro';
import SiteHead from '../components/SiteHead.astro';
import { projects } from '../data/projects';
---

<html lang="en" data-theme="dark">
  <head>
    <SiteHead />
  </head>
  <body>
    <main id="top" class="page-shell">
      <section class="frame hero-frame" aria-label="FREDDIE K. portfolio introduction">
        <Header />

        <div class="hero-grid">
          <Hero />
        </div>
      </section>

      <section class="content-stack" aria-label="FREDDIE K. portfolio sections">
        <section id="about" class="section-panel frame" aria-labelledby="about-title" data-animate="section-panel">
          <SectionLabel id="about-title">About</SectionLabel>
          <p class="mono-copy">
            I’m figuring out where these tools are useful to me by trying them on projects.
            This site is where I share those experiments, what worked, and what I’m still working out.
          </p>
          <a class="section-pointer" href="/about">More about me →</a>
        </section>



        <section id="work" class="section-panel frame" aria-labelledby="work-title" data-animate="section-panel">
          <SectionLabel id="work-title">Projects & Experiments</SectionLabel>
          <ul class="project-list" aria-label="Projects">
            {projects.map((project) => <ProjectCard project={project} />)}
          </ul>
          <a class="section-pointer" href="/labs">Browse labs →</a>
        </section>
      </section>

      <FooterStatus />
    </main>

    <script>
      import { gsap } from 'gsap';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        // Hero sub-elements
        gsap.set('[data-animate="hero-portrait"]', { autoAlpha: 0, scale: 0.96, y: 10 });
        gsap.set('[data-animate="hero-eyebrow"]', { autoAlpha: 0, y: 10 });
        gsap.set('[data-animate="hero-heading"]', { autoAlpha: 0, y: 18 });
        gsap.set('[data-animate="hero-subhead"]', { autoAlpha: 0, y: 14 });
        gsap.set('[data-animate="hero-tag"]', { autoAlpha: 0, x: -10 });

        gsap.set('[data-animate="section-panel"], [data-animate="project-card"]', {
          autoAlpha: 0,
          y: 18,
        });

        const heroTl = gsap.timeline({ defaults: { ease: 'power2.out' } });
        heroTl
          .to('[data-animate="hero-portrait"]', { autoAlpha: 1, scale: 1, y: 0, duration: 0.65 })
          .to('[data-animate="hero-eyebrow"]',  { autoAlpha: 1, y: 0, duration: 0.4 }, '-=0.35')
          .to('[data-animate="hero-heading"]',  { autoAlpha: 1, y: 0, duration: 0.5 }, '-=0.28')
          .to('[data-animate="hero-subhead"]',  { autoAlpha: 1, y: 0, duration: 0.4 }, '-=0.22')
          .to('[data-animate="hero-tag"]',      { autoAlpha: 1, x: 0, duration: 0.32, stagger: 0.07 }, '-=0.18');

        gsap.to('[data-animate="section-panel"]', {
          autoAlpha: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          stagger: 0.08,
          delay: 0.08,
        });

        gsap.to('[data-animate="project-card"]', {
          autoAlpha: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          stagger: 0.07,
          delay: 0.22,
        });

      }
    </script>
  </body>
</html>

<style>
  .hero-frame {
    padding: 1rem 1rem 0.75rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.35rem, 2.5vw, 2rem) 0 clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .content-stack {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
  }

  .section-panel {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .section-pointer {
    justify-self: start;
    color: var(--accent);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-pointer:hover,
  .section-pointer:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: none;
    border-radius: var(--radius-md);
  }

  @media (max-width: 1180px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .page-shell {
      width: min(100%, calc(100% - 1rem));
      padding-top: 0.5rem;
    }

    .hero-frame {
      padding: 0.75rem;
    }
  }
</style>
