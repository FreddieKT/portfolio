---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageSidebar from '../components/PageSidebar.astro';
import SectionLabel from '../components/SectionLabel.astro';

const allNotes = await getCollection('notes');
const notes = allNotes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const sidebarItems = [{ label: 'ALL NOTES', href: '/notes' }];
---

<PageLayout title="Notes" description="Notes from things Freddie has tried and wants to remember.">
  <PageSidebar slot="sidebar" heading="NOTES" items={sidebarItems} activeHref="/notes" />

  <div class="notes-content">

    <header class="page-section frame" data-animate="page-section">
      <SectionLabel>Notes</SectionLabel>
      <p class="mono-copy">Notes from things I've tried and want to remember.</p>
    </header>

    {notes.length > 0 ? (
      <div class="notes-grid">
        {notes.map((note) => {
          const slug = note.id.replace(/\.md$/, '');
          return (
            <article class="note-card frame" data-animate="page-section">
              <div class="note-meta">
                <time class="note-date" datetime={note.data.date}>{note.data.date}</time>
                <span class="note-publisher" aria-label="Publisher">· {note.data.publisher}</span>
                {note.data.tags.length > 0 && (
                  <div class="note-tags" aria-label="Tags">
                    {note.data.tags.map((tag: string) => (
                      <span class="note-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <h2 class="note-title">
                <a href={`/notes/${slug}`}>{note.data.title}</a>
              </h2>
              <p class="mono-copy note-summary">{note.data.summary}</p>
              <a class="note-read-link" href={`/notes/${slug}`} aria-label={`Read: ${note.data.title}`}>
                Read note →
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <section class="page-section frame" data-animate="page-section">
        <div class="empty-state">// no notes yet</div>
      </section>
    )}

  </div>
</PageLayout>

<style>
  .notes-content {
    display: grid;
    gap: 1rem;
  }

  .page-section {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: grid;
    gap: 0.75rem;
  }

  .notes-grid {
    display: grid;
    gap: 1rem;
  }

  /* Note card */
  .note-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius-md);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .note-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-glow);
  }

  /* Meta row — date + publisher + tags */
  .note-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .note-date,
  .note-publisher {
    font-size: var(--text-xs);
    color: var(--muted-faint);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .note-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .note-tag {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border: 1px dashed var(--border-dashed-color);
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Title */
  .note-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .note-title a {
    color: var(--foreground);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .note-title a:hover {
    color: var(--accent);
  }

  /* Summary */
  .note-summary {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
    max-width: 72ch;
  }

  /* Read link */
  .note-read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.25rem;
    transition: gap 160ms ease;
  }

  .note-read-link:hover {
    gap: 0.75rem;
  }

  .empty-state {
    font-size: var(--text-sm);
    color: var(--muted);
    padding: 1rem;
    border: var(--border-dashed);
    font-family: var(--font-mono);
  }
</style>
