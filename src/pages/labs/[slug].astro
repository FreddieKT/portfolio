---
import PageLayout from '../../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import PageSidebar from '../../components/PageSidebar.astro';

import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const idx = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];

const sidebarItems = projects.map((p) => ({
  label: p.title,
  href: `/labs/${p.slug}`,
}));
---

<PageLayout title={project.title} description={project.summary}>
  <PageSidebar
    slot="sidebar"
    heading="LABS"
    items={sidebarItems}
    activeHref={`/labs/${project.slug}`}
  />

  <article class="labs-detail">
    <div class="page-section frame combined-panel" data-animate="page-section">
      <div class="markdown-prose">
        <h1>{project.title}</h1>
        <p class="meta"><strong>{project.category}</strong> &middot; {project.label}</p>

        <h2>Summary</h2>
        <p>{project.summary}</p>
        {project.image && <Image class="project-image" src={project.image} alt={project.imageAlt ?? project.title} widths={[480, 800, 1200]} sizes="(max-width: 720px) 90vw, 800px" loading="eager" />}

        {project.problem && <><h2>Problem</h2><p>{project.problem}</p></>}

        {project.does && <><h2>What it does</h2><p>{project.does}</p></>}

        <h2>Stack</h2>
        <ul>
          {project.stack.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <h2>Status</h2>
        <p>{project.status}</p>

        {project.secondaryImage && (
          <figure class="project-figure">
            <Image class="project-image" src={project.secondaryImage} alt={project.secondaryImageAlt ?? project.title} widths={[480, 800, 1200]} sizes="(max-width: 720px) 90vw, 800px" loading="lazy" />
            {project.secondaryImageCaption && <figcaption>{project.secondaryImageCaption}</figcaption>}
          </figure>
        )}
        {project.nextStep && <><h2>Next step</h2><p>{project.nextStep}</p></>}

        {project.sourceUrl && <><h2>Source</h2><p><a href={project.sourceUrl} target="_blank" rel="noreferrer">View the repository on GitHub ↗</a></p></>}
      </div>
    </div>

    <nav class="page-section frame project-nav" aria-label="Project navigation" data-animate="page-section">
      <a class="nav-pill" href={`/labs/${prev.slug}`}>← {prev.title}</a>
      <a class="nav-pill" href={`/labs/${next.slug}`}>{next.title} →</a>
    </nav>
  </article>
</PageLayout>

<style>
  .project-figure { margin: 1rem 0; }
  .project-figure .project-image { margin-bottom: 0.5rem; }
  .project-figure figcaption { font-size: var(--text-xs); color: var(--muted); letter-spacing: 0.04em; }
  .project-image { display: block; width: 100%; height: auto; border-radius: var(--radius-md); margin: 1rem 0; }
  .labs-detail {
    display: grid;
    gap: 1rem;
  }

  .page-section {
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .combined-panel {
    background: var(--panel-overlay);
  }

  .markdown-prose {
    font-family: var(--font-mono);
    color: var(--foreground-soft);
    line-height: 1.6;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .markdown-prose h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--foreground);
    margin: 0 0 0.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .markdown-prose h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--foreground);
    margin: 2rem 0 0.75rem 0;
    padding-bottom: 0.25rem;
    border-bottom: none;
    text-transform: uppercase;
  }

  .markdown-prose p {
    margin: 0 0 1rem 0;
  }

  .markdown-prose .meta {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .markdown-prose ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .markdown-prose li {
    margin-bottom: 0.5rem;
  }

  .markdown-prose li::marker {
    color: var(--accent);
  }

  .project-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
</style>
