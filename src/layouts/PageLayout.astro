---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FooterStatus from '../components/FooterStatus.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <SiteHead title={title} description={description} path={path} />
  </head>
  <body>
    <main id="top" class="page-shell">
      <div class="frame page-frame">
        <Header navItems={[
          { label: 'ABOUT', href: '/about' },
          { label: 'LABS',  href: '/labs' },
        ]} />
        <div class="page-layout">
          <slot name="sidebar" />
          <div class="page-main">
            <slot />
          </div>
        </div>
      </div>
      <FooterStatus />
    </main>
  </body>
</html>

<style>
  .page-frame {
    padding: 1rem 1rem 0.75rem;
  }

  .page-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    align-items: start;
  }

  .page-main {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .page-frame {
      padding: 0.75rem;
    }

    .page-layout {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 0.75rem 0;
    }
  }
</style>
